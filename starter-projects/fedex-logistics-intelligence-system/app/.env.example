# Server-side Gemini API key (NEVER prefix with VITE_)
GEMINI_API_KEY=your_gemini_api_key_here

# GCP forward path: authenticate via Vertex AI instead of an API key.
# Takes priority over GEMINI_API_KEY when set. Credentials come from
# Application Default Credentials (Cloud Run service account in prod,
# `gcloud auth application-default login` locally).
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

# Optional: Gemini model id override (default: gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash

# Optional: serve REAL public data (Open-Meteo, NWS alerts, USGS quakes) from
# GET /api/live-signals. Off by default — the demo serves labeled synthetic
# data until an operator deliberately turns this on.
# LIVE_SIGNALS=on

# Optional: port override
PORT=3000
