# Copy to .env (gitignored). Use ONE of the two auth paths below.

# Path A — Gemini API key (AI Studio / Gemini API):
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=your-key-here

# Path B — Vertex AI (enterprise path; needs `gcloud auth application-default login`):
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

# Optional model override (default: gemini-2.5-flash)
# SHIFT_BRIEF_MODEL=gemini-2.5-flash
